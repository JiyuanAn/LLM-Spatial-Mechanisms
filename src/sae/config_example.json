{
  "experiment_name": "spatial_sae_experiment",
  "description": "SAE training for Layer 8 spatial reasoning features",
  
  "model": {
    "name": "Qwen/Qwen2.5-7B-Instruct",
    "device": "cuda:0",
    "dtype": "float16"
  },
  
  "data": {
    "train_file": "../dataGenerate/spatial_reasoning_dataset_ZH.json",
    "test_file": "../dataGenerate/spatial_reasoning_dataset_ZH_test.json",
    "max_train_samples": null,
    "max_test_samples": 1000
  },
  
  "sae": {
    "layer": 8,
    "hook_point": "hook_mlp_out",
    "n_features": 2048,
    "l1_coefficient": 0.001,
    "expansion_factor": null
  },
  
  "training": {
    "num_epochs": 5,
    "batch_size": 128,
    "learning_rate": 0.0003,
    "optimizer": "adam",
    "seed": 42
  },
  
  "analysis": {
    "top_k_features": 50,
    "correlation_threshold": 0.15,
    "activation_freq_threshold": 0.01
  },
  
  "output": {
    "output_dir": "./sae_results",
    "save_checkpoints": true,
    "save_plots": true,
    "verbose": true
  },
  
  "notes": [
    "基于 layer sweep probe 结果选择 Layer 8",
    "2048 features = 稳妥的第一轮配置",
    "l1_coefficient 控制稀疏度（越大越稀疏）",
    "hook_mlp_out 比 hook_resid_post 更适合空间特征"
  ]
}


